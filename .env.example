# Copy this file to .env and adjust for your local machine.
# .env itself is gitignored — never commit real secrets or connection strings.

# Port the Express server listens on.
PORT=4000

# MongoDB connection string. Leave this blank to run the API without a
# database connection — the health check (and everything else right now,
# since no route uses persistence yet) will still work.
MONGODB_URI=

# development | production
NODE_ENV=development
